{
  "expo": {
    "name": "coca",
    "slug": "repa2",
    "scheme": "usuarioapi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono_aplicacion.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash_screen_aplicacion.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icono_aplicacion.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true,
      "package": "com.polistp98.repa2"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "015b4f27-2764-4d0f-b61a-03879d7879a8"
      }
    }
  }
}
